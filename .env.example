# --------------------------------------------------------------------------
# AutoSMM AI — dashboard (Vite + Express)
# Copy to `.env`:  cp .env.example .env
# --------------------------------------------------------------------------

# Where the FastAPI backend is reachable from this Node process.
BACKEND_URL=http://localhost:8000

# Must match API_KEY in backend/.env. Injected server-side by the Express
# proxy, so it never reaches the browser.
AUTOSMM_API_KEY=change-me-super-secret-api-key

# Dashboard port.
PORT=3000

# Optional: only needed if you point the browser straight at the backend
# instead of using the proxy (then CORS_ORIGINS in backend/.env must allow it).
# VITE_API_URL=http://localhost:8000
# VITE_API_KEY=change-me-super-secret-api-key

# Optional: legacy /api/ai/generate playground route.
GEMINI_API_KEY=
