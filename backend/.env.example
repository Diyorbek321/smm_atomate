# ==========================================================================
# AutoSMM AI — environment configuration
# Copy to `.env` and fill in real values:  cp .env.example .env
# ==========================================================================

# --- Application ---------------------------------------------------------
APP_NAME="AutoSMM AI"
ENV=development                       # development | staging | production
DEBUG=true
LOG_LEVEL=INFO
# Publicly reachable base URL. Instagram downloads media from here, so in
# production this MUST be a real HTTPS domain (ngrok works for local tests).
PUBLIC_BASE_URL=http://localhost:8000
# Comma separated origins allowed to call the REST API (admin dashboard).
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Security ------------------------------------------------------------
# Static key clients must send in the `X-API-Key` header.
API_KEY=change-me-super-secret-api-key
SECRET_KEY=change-me-32-chars-minimum-secret
# Fernet key used to encrypt tokens at rest.
# Generate: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# --- Database ------------------------------------------------------------
POSTGRES_USER=autosmm
POSTGRES_PASSWORD=autosmm
POSTGRES_DB=autosmm
# docker-compose overrides this with the service name 'postgres'.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Optional override; built from the parts above when empty.
DATABASE_URL=

# --- Redis / Celery ------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- LLM provider (text, planning, self-reflection) ----------------------
# gemini | openai | groq  — `openai` and `groq` both speak the OpenAI
# chat-completions protocol, so any compatible endpoint works.
LLM_PROVIDER=gemini
LLM_TEMPERATURE=0.9
LLM_MAX_OUTPUT_TOKENS=8192

# --- Gemini --------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL_FAST=gemini-1.5-flash
GEMINI_MODEL_PRO=gemini-1.5-pro
GEMINI_MAX_OUTPUT_TOKENS=4096
# Gemini 2.5+/3.x burn output tokens on hidden reasoning, which truncates
# answers and inflates cost. 0 disables it, -1 lets the model decide.
GEMINI_THINKING_BUDGET=0
GEMINI_TEMPERATURE=0.9

# --- Image generation (Flux.1 Schnell) ----------------------------------
IMAGE_PROVIDER=fal                    # fal | replicate | none
FAL_API_KEY=
FAL_MODEL=fal-ai/flux/schnell
REPLICATE_API_TOKEN=
REPLICATE_MODEL=black-forest-labs/flux-schnell

# --- OpenAI-compatible providers -----------------------------------------
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL_FAST=gpt-4o-mini
OPENAI_MODEL_PRO=gpt-4o

GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL_FAST=openai/gpt-oss-20b
GROQ_MODEL_PRO=openai/gpt-oss-120b

# --- Voice transcription -------------------------------------------------
TRANSCRIPTION_PROVIDER=openai         # openai | groq | gemini
GROQ_WHISPER_MODEL=whisper-large-v3
OPENAI_API_KEY=
WHISPER_MODEL=whisper-1

# --- Telegram ------------------------------------------------------------
# System bot used for the approval workflow (per-business bots are stored in
# the `business_credentials` table and take priority when publishing).
TELEGRAM_BOT_TOKEN=
TELEGRAM_USE_WEBHOOK=false
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
# Comma separated Telegram user ids with superadmin rights.
TELEGRAM_ADMIN_IDS=

# --- Meta / Instagram Graph API -----------------------------------------
META_GRAPH_VERSION=v21.0
META_GRAPH_BASE=https://graph.facebook.com
META_APP_ID=
META_APP_SECRET=

# --- Media storage -------------------------------------------------------
# Host path used for local runs; docker-compose overrides it with /app/media.
MEDIA_ROOT=./media
MEDIA_URL_PREFIX=/media
MEDIA_RETENTION_DAYS=45

# --- Behaviour -----------------------------------------------------------
DEFAULT_TIMEZONE=Asia/Tashkent
DEFAULT_LANGUAGE=uz
HTTP_TIMEOUT=60
AI_MAX_RETRIES=3
MAX_PUBLISH_RETRIES=3
PUBLISH_BATCH_SIZE=25
AUTO_APPROVE=false                    # publish without human review (not recommended)

# --- Host port mappings (docker-compose) ---------------------------------
# Change these when the default ports are already taken on your machine.
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
API_HOST_PORT=8000
FLOWER_HOST_PORT=5555

# Posts generated in parallel. Lower to 1 when the LLM meters tokens per
# minute (Groq's free tier allows 8000 tokens/minute, and the requested
# completion budget counts against it).
GENERATION_CONCURRENCY=3

# --- Optional: self-hosted Bot API server (lifts the 20 MB download cap) ---
# Needed for the video editor to accept real phone footage.
# Get the credentials from https://my.telegram.org → API development tools.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Set to http://telegram-api:8081 once the telegram-api service is running.
TELEGRAM_API_BASE=
